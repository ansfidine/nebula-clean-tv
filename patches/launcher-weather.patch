+    /**
+     * The header weather, read from the Weather add-on's local provider. The launcher has no INTERNET
+     * permission: the add-on fetches, this only displays its latest reading. Hidden when that app has no
+     * city or no reading yet.
+     */
+    private void updateWeather() {
+        new Thread(() -> {
+            String city = null, temp = null, condition = null, high = null, low = null, lowC = null;
+            int code = -1, day = 1;
+            try (Cursor cursor = getContentResolver().query(
+                    Uri.parse("content://io.github.sumyabazar1.weather.current/current"),
+                    null, null, null, null)) {
+                if (cursor != null && cursor.moveToFirst()) {
+                    city = cursor.getString(cursor.getColumnIndexOrThrow("city"));
+                    temp = cursor.getString(cursor.getColumnIndexOrThrow("temp"));
+                    condition = cursor.getString(cursor.getColumnIndexOrThrow("condition"));
+                    high = cursor.getString(cursor.getColumnIndexOrThrow("high"));
+                    low = cursor.getString(cursor.getColumnIndexOrThrow("low"));
+                    lowC = cursor.getString(cursor.getColumnIndexOrThrow("low_c"));
+                    code = cursor.getInt(cursor.getColumnIndexOrThrow("code"));
+                    day = cursor.getInt(cursor.getColumnIndexOrThrow("day"));
+                }
+            } catch (Exception ignored) {
+            }
+            final String cityOut = city;
+            final String tempOut = temp;
+            final String conditionOut = condition;
+            final String highOut = high;
+            final String lowOut = low;
+            final String lowCOut = lowC;
+            final int codeOut = code;
+            final int dayOut = day;
+            runOnUiThread(() -> {
+                if (isFinishing() || isDestroyed()) return;
+                if (cityOut == null) {
+                    weatherBlock.setVisibility(View.GONE);
+                    return;
+                }
+                weatherCity.setText(cityOut.toUpperCase(Locale.getDefault()));
+                weatherTemp.setText(tempOut);
+                weatherDetail.setText(conditionOut + " · " + highOut + " / " + lowOut);
+                weatherIcon.setImageResource(codeOut <= 1
+                        ? (dayOut != 0 ? R.drawable.ic_weather_sun : R.drawable.ic_weather_moon)
+                        : R.drawable.ic_weather_cloud);
+                String tip;
+                try {
+                    double lowValue = Double.parseDouble(lowCOut);
+                    if (lowValue <= 5) tip = getString(R.string.weather_tip_warm);
+                    else if (lowValue <= 12) tip = getString(R.string.weather_tip_light);
+                    else if (lowValue <= 18) tip = getString(R.string.weather_tip_sleeves);
+                    else tip = getString(R.string.weather_tip_tshirt);
+                } catch (Exception e) {
+                    tip = getString(R.string.weather_tip_light);
+                }
+                weatherTip.setText(tip + " · " + getString(R.string.weather_low, lowOut));
+                weatherBlock.setVisibility(View.VISIBLE);
+            });
+        }, "weather-header").start();
+    }
+
