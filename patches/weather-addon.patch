diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherCache.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherCache.java
new file mode 100644
index 0000000..8ddd6fc
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherCache.java
@@ -0,0 +1,41 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.Context;
+
+import org.json.JSONObject;
+
+/** The latest reading, kept for the launcher's header widget. No network, no location. */
+final class WeatherCache {
+    private static final String PREFS = "weather_cache";
+    private static final String KEY = "data";
+
+    private WeatherCache() { }
+
+    static void save(Context context, String city, Forecast.Report report, boolean fahrenheit) {
+        try {
+            JSONObject data = new JSONObject();
+            data.put("city", city);
+            data.put("tempC", report.tempC);
+            data.put("feelsC", report.feelsC);
+            data.put("code", report.code);
+            data.put("day", report.day);
+            data.put("todayMaxC", report.todayMaxC);
+            data.put("todayMinC", report.todayMinC);
+            data.put("fahrenheit", fahrenheit);
+            data.put("updated", System.currentTimeMillis());
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+                    .edit().putString(KEY, data.toString()).apply();
+        } catch (Exception ignored) {
+        }
+    }
+
+    static JSONObject read(Context context) {
+        String raw = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY, null);
+        if (raw == null) return null;
+        try {
+            return new JSONObject(raw);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherProvider.java b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherProvider.java
new file mode 100644
index 0000000..7c03ba3
--- /dev/null
+++ b/addons/weather/app/src/main/java/io/github/sumyabazar1/weather/WeatherProvider.java
@@ -0,0 +1,78 @@
+package io.github.sumyabazar1.weather;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+
+import org.json.JSONObject;
+
+/**
+ * Read-only local data for the launcher's header weather widget. The launcher has no INTERNET
+ * permission; this provider hands it the latest reading the weather app already fetched.
+ */
+public final class WeatherProvider extends ContentProvider {
+    static final String AUTHORITY = "io.github.sumyabazar1.weather.current";
+    private static final String[] COLUMNS = {
+            "city", "temp", "condition", "high", "low", "low_c", "code", "day", "unit", "updated"
+    };
+
+    @Override
+    public boolean onCreate() {
+        return true;
+    }
+
+    @Override
+    public Cursor query(Uri uri, String[] projection, String selection, String[] selectionArgs, String sortOrder) {
+        MatrixCursor cursor = new MatrixCursor(COLUMNS);
+        if (getContext() == null) return cursor;
+        JSONObject data = WeatherCache.read(getContext());
+        if (data == null) return cursor;
+
+        boolean fahrenheit = data.optBoolean("fahrenheit");
+        int code = data.optInt("code");
+        boolean day = data.optBoolean("day", true);
+        String city = data.optString("city", "");
+        double tempC = data.optDouble("tempC", Double.NaN);
+        double highC = data.optDouble("todayMaxC", Double.NaN);
+        double lowC = data.optDouble("todayMinC", Double.NaN);
+        if (city.isEmpty() || Double.isNaN(tempC) || Double.isNaN(highC) || Double.isNaN(lowC)) {
+            return cursor;
+        }
+
+        cursor.addRow(new Object[]{
+                city,
+                Forecast.degrees(tempC, fahrenheit) + "°",
+                getContext().getString(Forecast.sky(code, day)),
+                Forecast.degrees(highC, fahrenheit) + "°",
+                Forecast.degrees(lowC, fahrenheit) + "°",
+                String.valueOf(lowC),
+                code,
+                day ? 1 : 0,
+                fahrenheit ? "F" : "C",
+                data.optLong("updated")
+        });
+        return cursor;
+    }
+
+    @Override
+    public String getType(Uri uri) {
+        return "vnd.android.cursor.item/weather";
+    }
+
+    @Override
+    public Uri insert(Uri uri, ContentValues values) {
+        throw new UnsupportedOperationException("read-only");
+    }
+
+    @Override
+    public int delete(Uri uri, String selection, String[] selectionArgs) {
+        return 0;
+    }
+
+    @Override
+    public int update(Uri uri, ContentValues values, String selection, String[] selectionArgs) {
+        return 0;
+    }
+}
